<ui:FluentWindow x:Class="YunsuoDownloader.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="云梭下载器"
                 Width="1200" Height="800" MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="云梭下载器" ShowMinimize="True" ShowMaximize="True" />

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== 侧边导航 ==================== -->
            <Border Grid.Column="0" CornerRadius="8" Padding="0,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,4,16,14">
                        <TextBlock Text="云梭下载器" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                                   Text="v1.0.0" />
                    </StackPanel>

                    <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavListBoxStyle}"
                             SelectionChanged="OnNavSelectionChanged">
                        <ListBoxItem Tag="downloads">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE896;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="最近下载" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="newtask">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE710;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建任务" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="pan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE753;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="网盘解析" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="extension">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xEA86;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="浏览器插件" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE713;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="设置" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="about">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE946;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="关于与开源致谢" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="12,10,12,4">
                        <ui:Button x:Name="UpdateButton" Appearance="Secondary" HorizontalAlignment="Stretch"
                                   Content="检查更新" Click="OnCheckUpdateClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主内容区 ==================== -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:InfoBar x:Name="Info" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

                <ContentControl x:Name="ContentHost" Grid.Row="1" />

                <!-- 状态栏 -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,7" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="StatusSpeed" Text="0 B/s" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusTasks" Text="空闲" Margin="14,0,0,0" Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusTools" Text="" Margin="14,0,0,0" Opacity="0.6"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Content="下载目录" Click="OnOpenDownloadFolderClick"
                                       Padding="10,4" />
                            <ui:Button Appearance="Transparent" Content="日志" Click="OnOpenLogFolderClick"
                                       Padding="10,4" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
