<ui:FluentWindow x:Class="YunsuoDownloader.App.Views.Dialogs.PanLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="登录网盘"
                 Width="980" Height="720" MinWidth="720" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="TitleBarHost" Title="登录网盘" ShowMinimize="False"
                     ShowMaximize="False" />

        <Border Grid.Row="1" Margin="12,0" CornerRadius="8" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <wv2:WebView2 x:Name="Browser" />
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" />
                    <TextBlock Text="正在打开网盘登录页…" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="36" Text="&#xE783;"
                               HorizontalAlignment="Center" Foreground="#E81123" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12,10,12,12" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HintText" FontWeight="SemiBold" Text="在下面的窗口里登录网盘" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"
                               Text="登录完成后点右边的「我已完成登录」，程序会记住这次登录（加密保存在本机）。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="FinishButton" Appearance="Primary" Content="我已完成登录"
                               Click="OnFinishClick" />
                    <ui:Button Appearance="Secondary" Content="取消" Margin="8,0,0,0" Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
