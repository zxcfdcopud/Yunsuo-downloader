<UserControl x:Class="YunsuoDownloader.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:YunsuoDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2" MaxWidth="1020" HorizontalAlignment="Left">
            <TextBlock Text="关于与开源致谢" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="本程序的多线程下载、视频解析、HLS 处理能力来自若干优秀的开源项目；界面遵循 Microsoft Fluent 2 设计规范。" />

            <!-- ==================== 版本与更新（需求 10） ==================== -->
            <TextBlock Text="版本与更新" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="云梭下载器" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VersionText, StringFormat= v{0}}" FontSize="14"
                                           Margin="10,6,0,0" Opacity="0.75" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding UpdateFeed}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" Content="检查更新" Command="{Binding CheckCommand}" />
                        </StackPanel>
                    </Grid>

                    <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" HorizontalAlignment="Left"
                                     Margin="0,10,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 有新版本 -->
                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="6"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="发现新版本 " />
                                <Run Text="{Binding NewVersionText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ReleaseNotes}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       MaxHeight="220" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Appearance="Primary" Content="下载新版本" Command="{Binding DownloadUpdateCommand}" />
                                <ui:Button Appearance="Secondary" Content="立即安装" Margin="6,0,0,0"
                                           Command="{Binding InstallUpdateCommand}" />
                                <ui:Button Appearance="Secondary" Content="打开发布页" Margin="6,0,0,0"
                                           Command="{Binding OpenReleasePageCommand}" />
                                <ui:Button Appearance="Secondary" Content="忽略此版本" Margin="6,0,0,0"
                                           Command="{Binding SkipVersionCommand}" />
                            </WrapPanel>
                            <ProgressBar Height="5" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding DownloadProgress}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 许可与文档 ==================== -->
            <TextBlock Text="许可、免责与使用文档" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap"
                               Text="本程序是本地下载工具：不提供、不托管任何受版权保护的内容，也不绕过任何付费/DRM 保护。请仅下载你有权下载的内容（自己的文件、公开授权资源、CC 协议作品等），并遵守目标网站的服务条款。" />
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Appearance="Primary" Content="用户协议 / EULA"
                                   Command="{Binding OpenSpecificDocCommand}" CommandParameter="EULA.txt" />
                        <ui:Button Appearance="Secondary" Content="使用手册" Margin="6,0,0,0"
                                   Command="{Binding OpenSpecificDocCommand}" CommandParameter="使用手册.txt" />
                        <ui:Button Appearance="Secondary" Content="开源借鉴清单" Margin="6,0,0,0"
                                   Command="{Binding OpenSpecificDocCommand}" CommandParameter="第三方开源项目清单.txt" />
                        <ui:Button Appearance="Secondary" Content="打开 docs 目录" Margin="6,0,0,0"
                                   Command="{Binding OpenDocsFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 开源致谢（需求 4） ==================== -->
            <TextBlock Text="开源项目致谢与借鉴说明" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"
                               Text="下面每一个项目都注明了用途与项目地址；完整说明（含许可证全文入口）见 docs/第三方开源项目清单.txt。" />
                    <ItemsControl ItemsSource="{Binding Credits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding License}" FontSize="11" Opacity="0.65"
                                                       Margin="10,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" />
                                        <ui:Button Appearance="Transparent" HorizontalAlignment="Left" Padding="0,4"
                                                   Margin="0,2,0,0"
                                                   Content="{Binding Url}"
                                                   Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Url}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 运行环境 ==================== -->
            <TextBlock Text="运行环境" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <ui:Button Appearance="Secondary" Content="刷新" HorizontalAlignment="Left"
                               Command="{Binding RefreshEnvironmentCommand}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding EnvironmentText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" MinHeight="150"
                             MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="1" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
