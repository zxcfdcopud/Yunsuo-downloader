<UserControl x:Class="YunsuoDownloader.App.Views.Pages.NewTaskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:YunsuoDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:NewTaskViewModel}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2">
            <TextBlock Text="新建任务" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="支持：普通直链 / 磁力链接 / 迅雷链接 / m3u8·HLS 直播与点播 / B站·YouTube·抖音·快手·小红书等视频页面。（网盘分享解析将于下个版本推出）" />

            <!-- ==================== 链接输入 ==================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="下载链接（每行一条，可批量粘贴）" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="UrlBox" Height="104" AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                PlaceholderText="例如：https://www.bilibili.com/video/BV1xx411c7mD"
                                Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Appearance="Secondary" Content="从剪贴板粘贴"
                                   Command="{Binding PasteFromClipboardCommand}" />
                        <ui:Button Appearance="Primary" Content="解析预览" Margin="8,0,0,0"
                                   Command="{Binding ParseCommand}" />
                        <ui:Button Appearance="Secondary" Content="查看解析日志" Margin="8,0,0,0"
                                   Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding ShowParseLogCommand}" />
                        <ui:Button Appearance="Secondary" Content="清空" Margin="8,0,0,0"
                                   Command="{Binding ClearCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 保存位置 ==================== -->
            <TextBlock Text="保存位置" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button Appearance="Secondary" Content="浏览…" Command="{Binding BrowseDirectoryCommand}" />
                            <ui:Button Appearance="Secondary" Content="打开" Margin="6,0,0,0"
                                       Command="{Binding OpenDirectoryCommand}" />
                            <ui:Button Appearance="Secondary" Content="用默认" Margin="6,0,0,0"
                                       Command="{Binding UseDefaultDirectoryCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 下载选项 ==================== -->
            <TextBlock Text="下载选项" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="视频清晰度" Style="{StaticResource FieldLabelStyle}" Width="90" />
                        <ComboBox Width="220" ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Display" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="仅对视频页面 / HLS 生效；如果所选画质不存在会自动取最接近的。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="下载线程" Style="{StaticResource FieldLabelStyle}" Width="90" />
                        <ComboBox Width="220" ItemsSource="{Binding ConnectionOptions}"
                                  SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Display" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource CaptionTextStyle}"
                               Margin="90,6,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="添加后立即开始下载" Margin="90,12,0,0" IsChecked="{Binding StartImmediately}" />
                </StackPanel>
            </Border>

            <!-- ==================== 解析结果 ==================== -->
            <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="解析结果" Style="{StaticResource SectionTitleStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="解析器：" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding DetectedProvider}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="    类型：" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding DetectedKind}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="    大小：" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding DetectedSize}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DetectedFileName}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="检测到的可用画质（点哪个就按哪个清晰度下载）"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding AvailableFormats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Margin="0,0,6,6" Padding="10,4" Appearance="Secondary"
                                               FontSize="12" Content="{Binding QualityText}"
                                               ToolTip="点它直接按这个清晰度开始下载"
                                               Command="{Binding DataContext.DownloadWithQualityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== 状态与提交 ==================== -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,24">
                <ui:Button Appearance="Primary" Content="开始下载" Padding="22,8"
                           Command="{Binding AddCommand}" />
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
