<UserControl x:Class="YunsuoDownloader.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:YunsuoDownloader.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}"
                       Text="所有改动即时生效并自动保存，不需要点“保存”按钮。" />

            <!-- ==================== 下载位置（需求 9） ==================== -->
            <TextBlock Text="下载位置" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="默认保存目录" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button Appearance="Primary" Content="浏览…" Command="{Binding BrowseDownloadDirectoryCommand}" />
                            <ui:Button Appearance="Secondary" Content="打开" Margin="6,0,0,0" Command="{Binding OpenDownloadDirectoryCommand}" />
                            <ui:Button Appearance="Secondary" Content="恢复默认" Margin="6,0,0,0" Command="{Binding ResetDownloadDirectoryCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DirectoryHint}" Style="{StaticResource CaptionTextStyle}" Margin="142,6,0,0" />
                    <CheckBox Content="每个视频任务单独建一个子文件夹" Margin="142,14,0,0"
                              IsChecked="{Binding CreateSubfolderPerTask}" />
                    <CheckBox Content="每次新建任务都询问保存位置" Margin="142,6,0,0"
                              IsChecked="{Binding AskForDirectoryEachTime}" />
                    <CheckBox Content="从列表移除任务时，同时删除已下载的文件（未完成的）" Margin="142,6,0,0"
                              IsChecked="{Binding DeleteFileWithTask}" />
                </StackPanel>
            </Border>

            <!-- ==================== 下载性能（需求 7） ==================== -->
            <TextBlock Text="下载性能" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="想更快？优先调“同时下载任务数”和“HLS 并发分片数”。单任务线程数不是越多越快：小文件、限速服务器、不支持断点续传的服务器都会被多线程拖慢，所以默认交给“自动”按文件推荐。" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="同时下载任务数" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1" Maximum="32" SmallChange="1"
                                      Value="{Binding MaxConcurrentDownloads}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="同时进行的任务数量（1~32）" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="线程数策略" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Column="1" Width="150" ItemsSource="{x:Static vm:SettingsViewModel.ConnectionModes}"
                                  SelectedItem="{Binding ConnectionModeDisplay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ConnectionModeHint}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="固定线程数" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1" Maximum="64" SmallChange="1"
                                      IsEnabled="{Binding IsFixedConnectionMode}"
                                      Value="{Binding ConnectionsPerDownload}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="模式选“固定值”时生效：所有任务都用这个线程数（1~64）" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自动模式上限" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1" Maximum="32" SmallChange="1"
                                      IsEnabled="{Binding IsAutoConnectionMode}"
                                      Value="{Binding AutoConnectionCap}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="自动推荐时最多开多少线程（1~32）。如果你发现“16 线程反而更慢”，把它调到 8 试试" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HLS 并发分片数" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1" Maximum="64" SmallChange="1"
                                      Value="{Binding ConcurrentFragments}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="m3u8 直播/点播的并发拉流数（1~64，推荐 16）" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="全局限速" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="0" Maximum="1048576" SmallChange="128"
                                      Value="{Binding GlobalSpeedLimitKbps}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="单位 KB/s，填 0 表示不限速" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最小分片大小" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1024" Maximum="1048576" SmallChange="256"
                                      Value="{Binding MinSplitSizeKb}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="单位 KB，aria2 硬性要求不小于 1024（1MB）" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 下载行为 ==================== -->
            <TextBlock Text="下载行为" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <CheckBox Content="添加任务后自动开始下载" IsChecked="{Binding AutoStartDownload}" />
                    <CheckBox Content="普通直链优先使用 aria2 引擎（多线程 + BT/磁力支持）" Margin="0,6,0,0"
                              IsChecked="{Binding UseAria2}" />
                    <CheckBox Content="视频页面优先使用 yt-dlp 解析（B站/YouTube/抖音等）" Margin="0,6,0,0"
                              IsChecked="{Binding UseYtDlpForVideoPages}" />
                    <CheckBox Content="HLS / m3u8 下载完成后自动转封装为 MP4" Margin="0,6,0,0"
                              IsChecked="{Binding AutoConvertHlsToMp4}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="默认清晰度" Style="{StaticResource FieldLabelStyle}" Width="130" />
                        <ComboBox Width="240" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding PreferredQuality}"
                                  DisplayMemberPath="Display" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 外观与运行 ==================== -->
            <TextBlock Text="外观与运行" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" Width="130" />
                        <ComboBox Width="200" ItemsSource="{x:Static vm:SettingsViewModel.Themes}"
                                  SelectedItem="{Binding ThemeDisplay}" />
                    </StackPanel>
                    <CheckBox Content="最小化时隐藏到系统托盘（关闭则最小化到任务栏，保留 Windows 系统动画）"
                              Margin="0,14,0,0" IsChecked="{Binding MinimizeToTray}" />
                    <CheckBox Content="点击关闭按钮时隐藏到托盘（不退出程序）" Margin="0,6,0,0" IsChecked="{Binding CloseToTray}" />
                    <CheckBox Content="开机自动启动（写入当前用户启动项，无需管理员）" Margin="0,6,0,0"
                              IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </Border>

            <!-- ==================== 浏览器插件 ==================== -->
            <TextBlock Text="浏览器插件" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <CheckBox Content="启用本地插件服务（下载器运行时生效）" IsChecked="{Binding ExtensionEnabled}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="监听端口" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="1024" Maximum="65535" SmallChange="1"
                                      Value="{Binding ExtensionPort}" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="重启服务" Margin="8,0,0,0"
                                   Command="{Binding RestartExtensionCommand}" />
                        <TextBlock Grid.Column="3" Text="{Binding ExtensionStatus}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="连接令牌" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" Text="{Binding ExtensionToken, Mode=OneWay}" IsReadOnly="True"
                                    FontFamily="Consolas" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <ui:Button Appearance="Primary" Content="复制" Command="{Binding CopyExtensionTokenCommand}" />
                            <ui:Button Appearance="Secondary" Content="重新生成" Margin="6,0,0,0"
                                       Command="{Binding RegenerateExtensionTokenCommand}" />
                            <ui:Button Appearance="Secondary" Content="插件目录" Margin="6,0,0,0"
                                       Command="{Binding OpenExtensionFolderCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="130,8,0,0"
                               Text="详细的安装步骤和排查清单在「浏览器插件」页。" />
                </StackPanel>
            </Border>

            <!-- ==================== 网盘账号（手动 Cookie 兜底） ==================== -->
            <TextBlock Text="网盘账号（Cookie）" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="推荐在「网盘解析」页点「登录」用内嵌浏览器登录，不用手抄 Cookie。这里保留手动粘贴：123 云盘的公开分享不需要登录；百度 / 夸克 需要登录态。Cookie 用 Windows DPAPI 加密保存在本机，只有当前 Windows 用户能解密，不会上传。Cookie 会过期，失效后重新登录一次即可。" />
                    <ItemsControl ItemsSource="{Binding PanRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Appearance="Primary" Content="设置 Cookie" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.EditCredentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Provider}" />
                                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="清除" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Provider}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== 网络与代理 ==================== -->
            <TextBlock Text="网络与代理" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="代理模式" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Column="1" Width="200" ItemsSource="{x:Static vm:SettingsViewModel.ProxyModes}"
                                  SelectedItem="{Binding ProxyModeDisplay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="在国内下载 YouTube 等站点时通常需要代理" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="代理地址" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" PlaceholderText="例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080"
                                    Text="{Binding ProxyUrl}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义 UA" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" PlaceholderText="留空使用内置 Chrome UA"
                                    Text="{Binding UserAgentOverride}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 外部工具 ==================== -->
            <TextBlock Text="外部工具（下载内核）" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ToolStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="aria2c.exe" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" Text="{Binding Aria2Path, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="指定…" Margin="8,0,0,0"
                                   Command="{Binding BrowseAria2Command}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="yt-dlp.exe" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" Text="{Binding YtDlpPath, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="指定…" Margin="8,0,0,0"
                                   Command="{Binding BrowseYtDlpCommand}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ffmpeg.exe" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1" Text="{Binding FfmpegPath, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Content="指定…" Margin="8,0,0,0"
                                   Command="{Binding BrowseFfmpegCommand}" />
                    </Grid>
                    <ui:Button Appearance="Secondary" Content="重新检测" Margin="130,10,0,0" HorizontalAlignment="Left"
                               Command="{Binding DetectToolsCommand}" />
                </StackPanel>
            </Border>

            <!-- ==================== 更新（需求 10） ==================== -->
            <TextBlock Text="更新" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <CheckBox Content="启动时自动检查更新" IsChecked="{Binding CheckUpdatesOnStartup}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="更新源地址" Style="{StaticResource FieldLabelStyle}" />
                        <ui:TextBox Grid.Column="1"
                                    PlaceholderText="留空则使用程序目录下的 update.json，其次使用内置 GitHub 源"
                                    Text="{Binding UpdateFeedUrl}" />
                        <ui:Button Grid.Column="2" Appearance="Primary" Content="立即检查" Margin="8,0,0,0"
                                   Command="{Binding CheckUpdateNowCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CaptionTextStyle}" Margin="130,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ==================== 数据与维护 ==================== -->
            <TextBlock Text="数据与维护" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="历史记录上限" Style="{StaticResource FieldLabelStyle}" />
                        <ui:NumberBox Grid.Column="1" Width="150" Minimum="20" Maximum="10000" SmallChange="50"
                                      Value="{Binding MaxHistoryItems}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" Text="超过后自动丢弃最旧的记录" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义解析规则" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Secondary" Content="打开 rules.json" Command="{Binding OpenRulesFileCommand}" />
                            <ui:Button Appearance="Secondary" Content="重新加载规则" Margin="6,0,0,0"
                                       Command="{Binding ReloadRulesCommand}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,16,0,0">
                        <ui:Button Appearance="Secondary" Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" />
                        <ui:Button Appearance="Secondary" Content="打开日志目录" Margin="6,0,0,0" Command="{Binding OpenLogDirectoryCommand}" />
                        <ui:Button Appearance="Secondary" Content="打开工具目录" Margin="6,0,0,0" Command="{Binding OpenToolsDirectoryCommand}" />
                        <ui:Button Appearance="Danger" Content="恢复默认设置" Margin="6,0,0,0" Command="{Binding ResetAllSettingsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
