<ui:FluentWindow x:Class="YunsuoDownloader.App.Views.MessageBoxWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="提示"
                 Width="520" SizeToContent="Height" MaxHeight="620"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="提示" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="24,6,24,0">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,18,24,20">
            <ui:Button x:Name="PrimaryButton" Appearance="Primary" MinWidth="110" Click="OnPrimary" />
            <ui:Button x:Name="SecondaryButton" Appearance="Secondary" MinWidth="110" Margin="8,0,0,0"
                       Click="OnSecondary" Visibility="Collapsed" />
            <ui:Button x:Name="CancelButton" Appearance="Secondary" Content="取消" MinWidth="110" Margin="8,0,0,0"
                       Click="OnCancel" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
