# ---------------------------------------------------------------- 构建产物
bin/
obj/
artifacts/
dist/
*.user
*.suo
*.userprefs
.vs/
.vscode/
*.swp

# ---------------------------------------------------------------- 外部工具（二进制，体积大）
# 仓库里不放 exe；用 scripts/fetch-tools.ps1 按需下载
tools/*.exe
tools/*.dll
tools/*.zip
tools/*.7z
tools/.cache/
tools/ffmpeg/
tools/LICENSE-*

# ---------------------------------------------------------------- 浏览器插件的签名产物
# extension.pem 是扩展的私钥：泄露后别人可以伪造本插件的签名包，
# 绝对不能进公开仓库。extension.crx 是签名后的包，也不需要提交。
*.pem
*.crx
*.pfx
*.key

# ---------------------------------------------------------------- 下载目录内容
downloads/*
!downloads/.gitkeep

# ---------------------------------------------------------------- 运行时数据（正常在 %AppData%，这里兜底）
logs/
*.log
*.fdlstate
*.aria2

# ---------------------------------------------------------------- 测试 / 临时
chrome-profile*/
ext-e2e/
node_modules/
*.tmp
*.bak

# ---------------------------------------------------------------- 官网源码（作者自己的独立工作，默认不进本仓库）
# 如果要一起公开，删掉下面这一行即可。
website/

# ---------------------------------------------------------------- 系统
Thumbs.db
desktop.ini
.DS_Store
